# ==============================================================================
# 🌹 FRONTEND ENVIRONMENT DRAFT (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env

# Base URL of the backend API
# - For local development: leave blank (uses Vite proxy) or http://localhost:5000
# - For production (e.g. Vercel, Netlify): set to your deployed backend URL:
#   VITE_API_URL=https://your-backend-api.onrender.com
VITE_API_URL=
