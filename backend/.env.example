# ==============================================================================
# 🌹 BACKEND ENVIRONMENT VARIABLES DRAFT (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Fill in your values below before running or deploying.

# --- SERVER SETTINGS ---
# Port number Express should listen on. Most cloud hosts (Render, Railway) set this automatically.
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=production

# --- MONGODB DATABASE CONFIGURATION ---
# Optional: If omitted, backend automatically falls back to safe in-memory storage.
# Free MongoDB Atlas cluster URI example:
# mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:StrongPassword123@cluster0.mongodb.net/sorry_love?retryWrites=true&w=majority

# --- CORS & SECURITY ---
# Comma-separated list of allowed frontend domains without trailing slashes.
# Add your deployed frontend URL (e.g. Vercel / Netlify domain) and local ports:
ALLOWED_ORIGINS=https://your-apology-website.vercel.app,http://localhost:5173
