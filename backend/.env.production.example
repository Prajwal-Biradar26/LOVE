# ==============================================================================
# 🌹 PRODUCTION BACKEND CONFIGURATION (RENDER / RAILWAY / HEROKU / VPS)
# ==============================================================================
# In your host's dashboard (e.g. Render Environment Variables, Railway Variables):
# Add the following keys:

PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (obtain from cloud.mongodb.com -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sorry_love?retryWrites=true&w=majority

# Your production frontend domain(s)
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
